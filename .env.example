# ─────────────────────────────────────────────────────────────
# spidey-portfolio — environment variables
# Copy this file to `.env.local` (or `.env`) and fill values.
# NEVER commit .env* files (they are git-ignored).
# ─────────────────────────────────────────────────────────────

# --- Contact form (Resend) -----------------------------------
# https://resend.com — API key for sending messages from /api/contact.
# RESEND_FROM and CONTACT_TO fall back to defaults if omitted.
RESEND_API_KEY=
RESEND_FROM="Portfolio Signal <onboarding@resend.dev>"
CONTACT_TO=

# Optional webhook URL (e.g. Discord/Slack) that receives contact
# submissions as a fallback channel alongside Resend.
CONTACT_WEBHOOK=